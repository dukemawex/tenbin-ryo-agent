# RYO builder credential (issued by the hackathon organiser). Required for live runs.
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=

# Free model via OpenRouter. Only ":free" models are used; the chain falls back in order.
OPENROUTER_API_KEY=
TENBIN_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Optional durable ledger (Upstash Redis REST). Without it, the CLI writes ./runs and the web app keeps an in-memory ledger.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects POST /api/run (manual runs) and the Vercel cron. Any long random string.
TENBIN_RUN_TOKEN=
CRON_SECRET=

# Practice-ledger settings (paper money only; nothing is ever traded)
TENBIN_PAPER_EQUITY_USD=10000
TENBIN_SHORTLIST=5
